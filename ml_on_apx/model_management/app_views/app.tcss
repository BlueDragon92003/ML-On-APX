GroupView, ModelView {
    layout: grid;
    grid-size: 2 1;
    grid-columns: 2fr 3fr;

    & .container {
        padding: 1;
    }

    & .title {
        color: $text-primary;
        text-style: bold;
        padding: 1;
        border: none;
    }

    & #navigation-panel {
        border: vkey $primary;

        & Button {
            width: 100%;
        }
    }
}

GroupView HorizontalGroup#control-buttons {
    layout: grid;
    grid-size: 4 1;

    & Button{
        width: 100%
    }
}

ModelView {

    & #group-title {
        text-align: center;
        padding: 1;
        width: 100%;
    }

    & HorizontalGroup#control-buttons {
        layout: grid;
        grid-size: 3 1;

        & Button{
            width: 100%
    }
}

}

CreateTrainingJobScreen {
    align: center top;
    & HorizontalGroup {
        width: 80%;
        min-width: 70;
        align: center middle;
    }
}

.bottom {
    dock: bottom;
}

