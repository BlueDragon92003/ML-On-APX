GroupView {
    layout: grid;
    grid-size: 2 1;
    grid-columns: 2fr 3fr;

    & .container {
        padding: 1;
    }

    & .title {
        color: $text-primary;
        text-style: bold;
        padding: 1;
        border: none;
    }

    & HorizontalGroup#control-buttons {
        layout: grid;
        grid-size: 3 1;

        & Button{
            width: 100%
        }
    }

    & #navigation-panel {
        border: vkey $primary;

        & Button {
            width: 100%;
        }
    }
}

.bottom {
    dock: bottom;
}

