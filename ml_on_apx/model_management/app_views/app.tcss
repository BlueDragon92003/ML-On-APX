GroupView {
    layout: grid;
    grid-size: 2 1;
    grid-columns: 2fr 3fr;

    & .container {
        padding: 1;
    }

    & .title {
        color: $text-primary;
        text-style: bold;
        padding: 1;
        border: none;
    }

    & HorizontalGroup#control-buttons {
        layout: grid;
        grid-size: 3 1;

        & Button{
            width: 100%
        }
    }

    & #navigation-panel {
        border: vkey $primary;

        & Button {
            width: 100%;
        }
    }
}

TabbedContent{
    & Tab {
        width: 1fr;
        text-align: center;
    }

    & ContentSwitcher {
        align-horizontal: center;

        & > * {
            width: 40%;
            min-width: 60;
        }

        & #name-label {
            padding: 1;
        }

        & ListItem Label {
            width: 100%;
            text-align: center;
        }

        & HorizontalGroup#new-label {
            layout: grid;
            grid-size: 2 1;
            grid-columns: 4fr 1fr;

            & Input {
                min-width: 48;
            }

            & Button {
                min-width: 10;
                width: 100%;
                margin: 0 1;
            }
        }
    }
}

